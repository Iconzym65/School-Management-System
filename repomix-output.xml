<file path="tests/Feature/AdminEndpointsTest.php">
<?php

namespace Tests\Feature;

use App\Models\AcademicYear;
use App\Models\Course;
use App\Models\Department;
use App\Models\Role;
use App\Models\Semester;
use App\Models\Timetable;
use App\Models\User;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Laravel\Sanctum\Sanctum;
use Tests\TestCase;

class AdminEndpointsTest extends TestCase
{
    use RefreshDatabase;

    protected Role $adminRole;
    protected Role $teacherRole;
    protected Role $studentRole;
    protected User $admin;

    protected function setUp(): void
    {
        parent::setUp();

        // Seed the required core roles
        $this->adminRole = Role::create(['name' => 'Admin', 'slug' => 'admin']);
        $this->teacherRole = Role::create(['name' => 'Teacher', 'slug' => 'teacher']);
        $this->studentRole = Role::create(['name' => 'Student', 'slug' => 'student']);

        // Create an active admin user for Sanctum authentication
        $this->admin = User::factory()->create([
            'role_id' => $this->adminRole->id,
            'status' => 'ACTIVE',
            'must_change_password' => false,
        ]);
    }

    public function test_admin_can_provision_teacher_account(): void
    {
        Sanctum::actingAs($this->admin);

        $payload = [
            'name' => 'Dr. Jane Smith',
            'email' => 'jane.smith@school.edu',
            'password' => 'TemporaryPassword123!',
        ];

        $response = $this->postJson('/api/v1/admin/teachers', $payload);

        $response->assertCreated();
        $this->assertDatabaseHas('users', [
            'email' => 'jane.smith@school.edu',
            'role_id' => $this->teacherRole->id,
        ]);
    }

    public function test_admin_can_toggle_student_payment_status(): void
    {
        Sanctum::actingAs($this->admin);

        $student = User::factory()->create([
            'role_id' => $this->studentRole->id,
            'status' => 'INACTIVE',
            'must_change_password' => false,
        ]);

        $response = $this->patchJson("/api/v1/admin/students/{$student->id}/status", [
            'status' => 'ACTIVE',
        ]);

        $response->assertOk();
        $this->assertDatabaseHas('users', [
            'id' => $student->id,
            'status' => 'ACTIVE',
        ]);
    }

    public function test_admin_can_create_course(): void
    {
        Sanctum::actingAs($this->admin);

        $dept = Department::create(['code' => 'CS', 'name' => 'Computer Science']);
        $academicYear = AcademicYear::create([
            'name' => '2026/2027',
            'starts_on' => '2026-09-01',
            'ends_on' => '2027-06-30',
            'is_current' => true,
        ]);
        $semester = Semester::create([
            'academic_year_id' => $academicYear->id,
            'name' => 'First Semester',
            'starts_on' => '2026-09-01',
            'ends_on' => '2027-01-31',
            'is_current' => true,
        ]);

        $payload = [
            'department_id' => $dept->id,
            'academic_year_id' => $academicYear->id,
            'semester_id' => $semester->id,
            'code' => 'CS101',
            'title' => 'Intro to Algorithms',
            'credit_hours' => 3,
        ];

        $response = $this->postJson('/api/v1/admin/courses', $payload);

        $response->assertCreated();
        $this->assertDatabaseHas('courses', ['code' => 'CS101']);
    }

    public function test_admin_can_schedule_timetable_with_virtual_meeting_link(): void
    {
        Sanctum::actingAs($this->admin);

        $teacher = User::factory()->create([
            'role_id' => $this->teacherRole->id,
            'status' => 'ACTIVE',
            'must_change_password' => false,
        ]);

        $dept = Department::create(['code' => 'MATH', 'name' => 'Mathematics']);
        $academicYear = AcademicYear::create(['name' => '2026/2027', 'starts_on' => '2026-09-01', 'ends_on' => '2027-06-30']);
        $semester = Semester::create(['academic_year_id' => $academicYear->id, 'name' => 'Sem 1', 'starts_on' => '2026-09-01', 'ends_on' => '2027-01-31']);
        
        $course = Course::create([
            'department_id' => $dept->id,
            'academic_year_id' => $academicYear->id,
            'semester_id' => $semester->id,
            'code' => 'MTH201',
            'title' => 'Calculus II',
            'credit_hours' => 3,
        ]);

        $payload = [
            'course_id' => $course->id,
            'teacher_id' => $teacher->id,
            'day_of_week' => 'monday',
            'start_time' => '10:00',
            'end_time' => '11:30',
            'meeting_link' => 'https://zoom.us/j/1234567890',
            'delivery_mode' => 'VIRTUAL',
        ];

        $response = $this->postJson('/api/v1/admin/timetables', $payload);

        $response->assertCreated();
        $this->assertDatabaseHas('timetables', [
            'course_id' => $course->id,
            'teacher_id' => $teacher->id,
            'meeting_link' => 'https://zoom.us/j/1234567890',
        ]);
    }

    public function test_admin_can_update_virtual_class_meeting_link(): void
    {
        Sanctum::actingAs($this->admin);

        $teacher = User::factory()->create(['role_id' => $this->teacherRole->id, 'status' => 'ACTIVE', 'must_change_password' => false]);
        $dept = Department::create(['code' => 'ENG', 'name' => 'English']);
        $academicYear = AcademicYear::create(['name' => '2026/2027', 'starts_on' => '2026-09-01', 'ends_on' => '2027-06-30']);
        $semester = Semester::create(['academic_year_id' => $academicYear->id, 'name' => 'Sem 1', 'starts_on' => '2026-09-01', 'ends_on' => '2027-01-31']);
        
        $course = Course::create([
            'department_id' => $dept->id,
            'academic_year_id' => $academicYear->id,
            'semester_id' => $semester->id,
            'code' => 'ENG101',
            'title' => 'Academic Writing',
            'credit_hours' => 2,
        ]);

        $timetable = Timetable::create([
            'course_id' => $course->id,
            'teacher_id' => $teacher->id,
            'day_of_week' => 'wednesday',
            'start_time' => '09:00',
            'end_time' => '10:30',
            'meeting_link' => 'https://zoom.us/j/old-link',
        ]);

        $response = $this->patchJson("/api/v1/admin/timetables/{$timetable->id}/meeting-link", [
            'meeting_link' => 'https://meet.google.com/new-link',
        ]);

        $response->assertOk();
        $this->assertDatabaseHas('timetables', [
            'id' => $timetable->id,
            'meeting_link' => 'https://meet.google.com/new-link',
        ]);
    }

    public function test_non_admin_cannot_access_admin_endpoints(): void
    {
        $student = User::factory()->create([
            'role_id' => $this->studentRole->id,
            'status' => 'ACTIVE',
            'must_change_password' => false,
        ]);

        Sanctum::actingAs($student);

        $response = $this->postJson('/api/v1/admin/teachers', [
            'name' => 'Unauthorized Teacher',
            'email' => 'unauthorized@school.edu',
            'password' => 'Password123!',
        ]);

        $response->assertForbidden();
    }
}
